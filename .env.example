# ─────────────────────────────────────────────────────────────────────────────
# Environment variable template — copy to .env.local and fill in real values.
# NEVER commit .env or .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Formspree form endpoint (server-side only — never expose in client code)
# Get yours at https://formspree.io/
FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Public site URL (used for OpenGraph meta tags)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
