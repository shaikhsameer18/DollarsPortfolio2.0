# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site URL ──────────────────────────────────────────────────────────────────
# Full public URL of your deployed site (no trailing slash).
# Used for: SEO metadataBase, Open Graph URLs, JSON-LD, CORS origin check,
#           sitemap.xml absolute URLs.
NEXT_PUBLIC_SITE_URL=https://sameerahmed.dev

# ── Contact Form ──────────────────────────────────────────────────────────────
# Formspree endpoint for the contact form.
# Get yours free at https://formspree.io → New Form → copy the endpoint URL.
# Kept SERVER-SIDE ONLY — this value is never sent to the browser.
FORMSPREE_ENDPOINT=https://formspree.io/f/XXXXXXXX

# ── Vercel Analytics & Speed Insights ────────────────────────────────────────
# Both are injected automatically by Vercel on deployment.
# You do NOT need to set these manually — leave them blank locally.
# Enable in Vercel Dashboard → Analytics tab and Speed Insights tab.
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=   # auto-set by Vercel
# VERCEL_SPEED_INSIGHTS_ID=          # auto-set by Vercel

# ── Google Search Console ─────────────────────────────────────────────────────
# After deploying, verify ownership at https://search.google.com/search-console
# Choose "HTML tag" method → copy the content="" value below.
# Add it to app/layout.tsx metadata.verification.google field.
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Analytics 4 (optional) ────────────────────────────────────────────
# Only add this if you need custom event tracking beyond Vercel Analytics.
# Get your Measurement ID from https://analytics.google.com
# Format: G-XXXXXXXXXX
# Note: Requires adding a <Script> tag in layout.tsx pointing to
#       https://www.googletagmanager.com/gtag/js?id=${GA_ID}
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Node Environment ──────────────────────────────────────────────────────────
# Automatically set by Next.js — do not change.
# "development" locally, "production" on Vercel.
NODE_ENV=development
